## Error messages
msgid "Cannot move a category under itself or one of its descendants."
msgstr "Неможливо перемістити категорію саму в себе або в одну з її дочірніх категорій."

msgid "Target belongs to a different catalogue. Move the category to the target catalogue first."
msgstr "Цільовий елемент належить іншому каталогу. Спочатку перемістіть категорію до цільового каталогу."

msgid "Parent category not found."
msgstr "Батьківську категорію не знайдено."

msgid "Categories must share the same parent to be reordered."
msgstr "Щоб змінити порядок, категорії мають мати спільну батьківську категорію."

msgid "Category not found."
msgstr "Категорію не знайдено."

msgid "Catalogue not found."
msgstr "Каталог не знайдено."

msgid "Item is already in this catalogue."
msgstr "Позиція вже є в цьому каталозі."

msgid "You must be logged in to upload files."
msgstr "Щоб завантажувати файли, потрібно увійти в систему."

msgid "Unsupported file format."
msgstr "Непідтримуваний формат файлу."

msgid "Unsupported file format. Please upload .xlsx or .csv."
msgstr "Непідтримуваний формат файлу. Завантажте файл .xlsx або .csv."

msgid "Not found."
msgstr "Не знайдено."

msgid "Missing item name."
msgstr "Відсутня назва позиції."

msgid "CSV file is empty."
msgstr "Файл CSV порожній."

msgid "This CSV file is not UTF-8 text. Save it as \"CSV UTF-8\" in your spreadsheet program and upload it again."
msgstr "Цей CSV-файл не в кодуванні UTF-8. Збережіть його в табличному редакторі як «CSV UTF-8» і завантажте знову."

msgid "This JSON file is not a catalogue export: it needs an \"items\" list of items with plain values."
msgstr "Цей JSON-файл не є експортом каталогу: у ньому має бути список «items» із позицій із простими значеннями."

msgid "Cannot restore — the parent catalogue is deleted. Restore the catalogue first."
msgstr "Неможливо відновити — батьківський каталог видалено. Спочатку відновіть каталог."

msgid "Cannot delete: %{count} smart items still reference this catalogue."
msgstr "Неможливо видалити: смарт-позицій, що посилаються на цей каталог: %{count}."

msgid "Each catalogue can only be referenced once per item."
msgstr "Кожен каталог можна вказати в позиції лише один раз."

msgid "Invalid price: %{raw}"
msgstr "Недійсна ціна: %{raw}"

msgid "Invalid markup: %{raw}"
msgstr "Недійсна націнка: %{raw}"

msgid "Sheet '%{sheet}' is empty."
msgstr "Аркуш '%{sheet}' порожній."

msgid "Failed to read sheet '%{sheet}'."
msgstr "Не вдалося прочитати аркуш '%{sheet}'."

msgid "Failed to open XLSX file."
msgstr "Не вдалося відкрити файл XLSX."

msgid "Failed to read XLSX file."
msgstr "Не вдалося прочитати файл XLSX."

msgid "Failed to parse CSV file."
msgstr "Не вдалося розібрати файл CSV."

msgid "Unexpected error: %{reason}"
msgstr "Неочікувана помилка: %{reason}"

